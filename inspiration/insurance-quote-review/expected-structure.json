{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copy this file into each inspo example directory and fill in the expected components/layout for that example.",
  "name": "insurance-quote-review",
  "description": "Review details for insurance quote",
  "components": {
    "HeadingField": { "minCount": 4 },
    "CardLayout": { "minCount": 7 },
    "TabsField": { "count": 0, "props": { "tabs": 0 } },
    "ButtonWidget": { "minCount": 5 },
    "TagField": { "minCount": 0 },
    "ReadOnlyGrid": { "count": 0 },
    "ImageField": { "minCount": 1 }
  },
  "layout": {
    "hasSidebar": false,
    "hasHeader": false,
    "hasTabs": false,
    "hasGrid": false
  },
  "sailMappings": {
    "$comment": "Map SAIL component names to expected Sailwind equivalents. Only relevant for S8/S9.",
    "a!cardLayout": "CardLayout",
    "a!headerContentLayout": "div with header section",
    "a!tabsField": "TabsField",
    "a!headingField": "HeadingField",
    "a!stampField": "StampField"
  }
}
